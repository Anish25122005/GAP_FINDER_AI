# ==============================================================================
# GapFinder AI - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase & Database Configuration
# ------------------------------------------------------------------------------
# Required for connecting to Supabase PostgreSQL & Auth.
# In local development without Supabase, the application falls back gracefully
# to an isolated local persisted storage layer.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Privileged service role key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
# Used only in administrative API routes and vector indexing operations.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# Optional direct PostgreSQL connection string (useful for raw migrations or Prisma)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. AI Provider Configuration (Unified Provider Abstraction)
# ------------------------------------------------------------------------------
# Supported providers: "openai", "gemini", or "mock" (for automated tests / offline)
AI_PROVIDER="openai"

# OpenAI Configuration
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Google Gemini Configuration (Alternative AI Provider)
GEMINI_API_KEY="AIzaSy-your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# ------------------------------------------------------------------------------
# 3. Application Settings & Rate Limiting
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Maximum upload file size in bytes (default: 15MB)
MAX_FILE_SIZE_BYTES="15728640"

# Rate limit for AI diagnostic calls (requests per minute per user)
AI_RATE_LIMIT_PER_MINUTE="30"
